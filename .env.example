# Copy this file to .env and fill in the values.

# Where enquiry notifications are delivered
ADMIN_EMAIL=laxmipower607@gmail.com

# SMTP account used to send mail.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (16 chars) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=laxmipower607@gmail.com
SMTP_PASS=
# Optional: sender address if different from SMTP_USER
MAIL_FROM=

# API server port
PORT=3001
# Origin allowed to call the API if the site is hosted elsewhere (e.g. https://laxmipower.in)
CORS_ORIGIN=*

# Front-end: full API URL if the API is on a different domain than the site.
# Leave empty when the server also hosts the site (default) or in dev.
VITE_CONTACT_API=
